# .env example file
# Copy it to .env and fill in the real values
# .env is gitignored, so it won't be committed to the repository
# .env.example is commited - shows what is needed

# App URL 
APP_URL=https://www.saucedemo.com

# Test credentials (saucedemo — these are public test creds)
APP_USERNAME=standard_user
APP_PASSWORD=secret_sauce

# API Testing 
API_BASE_URL=https://reqres.in/api
REQRES_API_KEY =your_real_api_key_here

# Test environment
TEST_ENV=staging

# Reporting
REPORT_DIR=reports
SCREENSHOT_DIR=screenshots